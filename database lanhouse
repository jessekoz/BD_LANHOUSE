CREATE DATABASE LANHOUSE;

USE LANHOUSE;



/*Criando Tabela Clientes*/

CREATE TABLE CLIENTES(
IDCLIENTE INT PRIMARY KEY AUTO_INCREMENT,
NOME VARCHAR (30),
CPF VARCHAR (11),
EMAIL VARCHAR (30),
DATA_CADASTRO DATE,
TELEFONE VARCHAR (11) 
);


/*Criando Tabela Computadores*/

CREATE TABLE COMPUTADORES(
IDCOMPUTADOR INT PRIMARY KEY AUTO_INCREMENT,
NUMERO_PC INT,
PROCESSADOR VARCHAR (30),
PLACA_VIDEO VARCHAR (30),
MEMORIA_RAM VARCHAR (30),
STATUS ENUM("LIVRE", "OCUPADO", "MANUTENÇÃO")
);



/*Criando Tabela Jogos*/

CREATE TABLE JOGOS (
 IDJOGOS INT PRIMARY KEY AUTO_INCREMENT,
 NOME_JOGO VARCHAR(30),
 CATEGORIA VARCHAR(30),
 CLASSIFICACAO_INDICATIVA VARCHAR(30),
 MULTIPLAYER VARCHAR(30)
);



/*Criando Tabela Sessões*/

CREATE TABLE SESSOES (
    IDSESSOES INT PRIMARY KEY AUTO_INCREMENT,

    HORARIO_INICIO DATETIME,
    HORARIO_FIM DATETIME,

    ID_CLIENTE INT NOT NULL,
    ID_COMPUTADOR INT NOT NULL,

    FOREIGN KEY (ID_CLIENTE)
        REFERENCES CLIENTES(IDCLIENTE),

    FOREIGN KEY (ID_COMPUTADOR)
        REFERENCES COMPUTADORES(IDCOMPUTADOR)
);



/*Criando Tabela Pagamentos*/

CREATE TABLE PAGAMENTOS(
IDPAGAMENTOS INT PRIMARY KEY AUTO_INCREMENT,
VALOR FLOAT(10,2),
FORMA_PAGAMENTO ENUM ("PIX", "A VISTA", "CARTAO CREDITO", "CARTAO DEBITO"),
ID_CLIENTE INT NOT NULL,
FOREIGN KEY	(ID_CLIENTE) REFERENCES CLIENTES (IDCLIENTE)
);



/*Criando Tabela Manutenção */

CREATE TABLE MANUTENCAO(
IDMANUTENCAO INT PRIMARY KEY AUTO_INCREMENT,
DATA_MANUTENCAO DATE,
DESCRICAO VARCHAR (500),
ID_COMPUTADOR INT,
ID_FUNCIONARIO INT,
FOREIGN KEY	(ID_COMPUTADOR) REFERENCES COMPUTADORES (IDCOMPUTADOR),
FOREIGN KEY	(ID_FUNCIONARIO) REFERENCES FUNCIONARIO (IDFUNCIONARIO)
);



/*Criando a tabela Funcionário*/

CREATE TABLE FUNCIONARIO(
IDFUNCIONARIO INT PRIMARY KEY AUTO_INCREMENT,
NOME VARCHAR (30),
CARGO VARCHAR (30),
SALARIO FLOAT (10,2),
TURNO ENUM ("MANHÃ", "TARDE", "NOITE"),
TELEFONE VARCHAR (30)
);




/*Criando Tabela Associativa Computador_Jogo*/

CREATE TABLE COMPUTADOR_JOGO (
    IDCOMPUTADOR INT,
    IDJOGOS INT,

    PRIMARY KEY (IDCOMPUTADOR, IDJOGOS),

    FOREIGN KEY (IDCOMPUTADOR)
        REFERENCES COMPUTADORES(IDCOMPUTADOR),

    FOREIGN KEY (IDJOGOS)
        REFERENCES JOGOS(IDJOGOS)
);



/*Criando a Tabela produtos */

CREATE TABLE PRODUTOS (
IDPRODUTO INT PRIMARY KEY AUTO_INCREMENT,
NOME VARCHAR (100) NOT NULL,
CATEGORIA VARCHAR (50) NOT NULL,
PRECO DECIMAL (6,2) NOT NULL,
ESTOQUE INT NOT NULL DEFAULT 0
);


/*Criando a tabela Associativa Produtos_Clientes */

CREATE TABLE CLIENTE_PRODUTO(
    IDCLIENTE INT,
    IDPRODUTO INT,
    QUANTIDADE INT,

    PRIMARY KEY (IDCLIENTE, IDPRODUTO),

    FOREIGN KEY (IDCLIENTE)
        REFERENCES CLIENTES(IDCLIENTE),

    FOREIGN KEY (IDPRODUTO)
        REFERENCES PRODUTOS(IDPRODUTO)
);



/* Criando tabela Torneios */

CREATE TABLE TORNEIOS (
IDTORNEIO INT PRIMARY KEY AUTO_INCREMENT,
NOME_TORNEIO VARCHAR (100) NOT NULL,
ID_JOGO INT,
DATA_TORNEIO DATE,
PREMIO VARCHAR (50),
FOREIGN KEY (ID_JOGO) REFERENCES JOGOS (IDJOGOS)
);



/*Criando Tabela Inscrições */

CREATE TABLE INSCRICOES (
IDINSCRICAO INT PRIMARY KEY AUTO_INCREMENT,
ID_CLIENTE INT,
ID_TORNEIO INT,
DATA_INSCRICAO DATE,
FOREIGN KEY (ID_CLIENTE) REFERENCES CLIENTES (IDCLIENTE),
FOREIGN KEY (ID_TORNEIO) REFERENCES TORNEIOS (IDTORNEIO)
);



/*Criando Tabela Vendas */

CREATE TABLE VENDAS(
IDVENDAS INT PRIMARY KEY AUTO_INCREMENT,
ID_SESSAO INT NOT NULL, 
ID_PRODUTO INT NOT NULL,
QUANTIDADE INT NOT NULL DEFAULT 1,
PRECO_UNITARIO DECIMAL (6,2) NOT NULL,
DATA_VENDA DATETIME,
FOREIGN KEY (ID_SESSAO) REFERENCES SESSOES (IDSESSOES),
FOREIGN KEY (ID_PRODUTO) REFERENCES PRODUTOS (IDPRODUTO)
);




/*Criando Tabela Audiotira_Caixa*/

CREATE TABLE AUDITORIA_CAIXA(
IDAUDITORIA INT PRIMARY KEY AUTO_INCREMENT,
TIPO ENUM ('ENTRADA', 'SAIDA') NOT NULL,
VALOR DECIMAL (8,2) NOT NULL,
DESCRICAO VARCHAR (255),
DATA_HORA DATETIME,
ID_SESSAO INT NOT NULL,
FOREIGN KEY (ID_SESSAO) REFERENCES SESSOES (IDSESSOES)
);




