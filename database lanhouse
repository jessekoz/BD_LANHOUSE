CREATE DATABASE LANHOUSE;

USE LANHOUSE;



/*Criando Tabela Clientes*/

CREATE TABLE CLIENTES(
IDCLIENTE INT PRIMARY KEY AUTO_INCREMENT,
NOME VARCHAR (30),
CPF VARCHAR (11),
EMAIL VARCHAR (30),
DATA_CADASTRO DATE,
TELEFONE VARCHAR (11) 
);


/*Criando Tabela Computadores*/

CREATE TABLE COMPUTADORES(
IDCOMPUTADOR INT PRIMARY KEY AUTO_INCREMENT,
NUMERO_PC INT,
PROCESSADOR VARCHAR (30),
PLACA_VIDEO VARCHAR (30),
MEMORIA_RAM VARCHAR (30),
STATUS ENUM("LIVRE", "OCUPADO", "MANUTENÇÃO")
);



/*Criando Tabela Jogos*/

CREATE TABLE JOGOS (
 IDJOGOS INT PRIMARY KEY AUTO_INCREMENT,
 NOME_JOGO VARCHAR(30),
 CATEGORIA VARCHAR(30),
 CLASSIFICACAO_INDICATIVA VARCHAR(30),
 MULTIPLAYER VARCHAR(30)
);



/*Criando Tabela Sessões*/

CREATE TABLE SESSOES (
    IDSESSOES INT PRIMARY KEY AUTO_INCREMENT,

    HORARIO_INICIO DATETIME,
    HORARIO_FIM DATETIME,

    ID_CLIENTE INT NOT NULL,
    ID_COMPUTADOR INT NOT NULL,

    FOREIGN KEY (ID_CLIENTE)
        REFERENCES CLIENTES(IDCLIENTE),

    FOREIGN KEY (ID_COMPUTADOR)
        REFERENCES COMPUTADORES(IDCOMPUTADOR)
);



/*Criando Tabela Pagamentos*/

CREATE TABLE PAGAMENTOS(
IDPAGAMENTOS INT PRIMARY KEY AUTO_INCREMENT,
VALOR FLOAT(10,2),
FORMA_PAGAMENTO ENUM ("PIX", "A VISTA", "CARTAO CREDITO", "CARTAO DEBITO"),
ID_CLIENTE INT NOT NULL,
FOREIGN KEY	(ID_CLIENTE) REFERENCES CLIENTES (IDCLIENTE)
);



/*Criando Tabela Manutenção */

CREATE TABLE MANUTENCAO(
IDMANUTENCAO INT PRIMARY KEY AUTO_INCREMENT,
DATA_MANUTENCAO DATE,
DESCRICAO VARCHAR (500),
ID_COMPUTADOR INT,
ID_FUNCIONARIO INT,
FOREIGN KEY	(ID_COMPUTADOR) REFERENCES COMPUTADORES (IDCOMPUTADOR),
FOREIGN KEY	(ID_FUNCIONARIO) REFERENCES FUNCIONARIO (IDFUNCIONARIO)
);



/*Criando a tabela Funcionário*/

CREATE TABLE FUNCIONARIO(
IDFUNCIONARIO INT PRIMARY KEY AUTO_INCREMENT,
NOME VARCHAR (30),
CARGO VARCHAR (30),
SALARIO FLOAT (10,2),
TURNO ENUM ("MANHÃ", "TARDE", "NOITE"),
TELEFONE VARCHAR (30)
);




/*Criando Tabela Associativa Computador_Jogo*/

CREATE TABLE COMPUTADOR_JOGO (
    IDCOMPUTADOR INT,
    IDJOGOS INT,

    PRIMARY KEY (IDCOMPUTADOR, IDJOGOS),

    FOREIGN KEY (IDCOMPUTADOR)
        REFERENCES COMPUTADORES(IDCOMPUTADOR),

    FOREIGN KEY (IDJOGOS)
        REFERENCES JOGOS(IDJOGOS)
);




